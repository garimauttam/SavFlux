# Public values for the Vite browser build. The anon key is safe to expose;
# NEVER use a Supabase service-role key in VITE_* variables.
# Local development: leave empty to use Vite's /api and /health proxies.
# For a deployed frontend, set the backend's public URL at build time.
VITE_API_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
