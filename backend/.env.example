# Copy this file to .env and fill in your values
# Never commit .env to git — it's in .gitignore

# ── Provider selection ────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "openai", "gemini", "ollama", or "deepseek".
#
#   openai  → GPT-4o for chat, text-embedding-3-small for embeddings
#             Requires OPENAI_API_KEY.  Best quality, costs ~$0.01/question.
#
#   gemini  → Gemini 1.5 Flash for chat, all-MiniLM-L6-v2 (local) for embeddings
#             Requires GEMINI_API_KEY.  Completely FREE, no credit card.
#             Get a key in 30 seconds: https://aistudio.google.com/app/apikey
#
#   ollama  → Local Qwen2.5-Coder or DeepSeek-Coder + local MiniLM embeddings
#             Requires Ollama running locally. No hosted quota or API key.
#
#   deepseek → Hosted DeepSeek API + local MiniLM embeddings
#              Requires DEEPSEEK_API_KEY. Uses the OpenAI-compatible API.
#
# ⚠️  IMPORTANT: embedding model is fixed at index time.
#     If you switch providers you MUST wipe chroma_data/ and re-index.
#
# Recommended: DeepSeek API -> Ollama local fallback
LLM_PROVIDER=gemini
# LLM_PROVIDER=openai
# LLM_PROVIDER=ollama
# LLM_PROVIDER=deepseek

# ── OpenAI (only needed when LLM_PROVIDER=openai) ────────────────────────────
# OPENAI_API_KEY=sk-...your-key-here...

# ── Gemini (only needed when LLM_PROVIDER=gemini) ────────────────────────────
GEMINI_API_KEY=your-gemini-key-from-aistudio.google.com

# ── Optional model overrides (defaults shown) ─────────────────────────────────
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Fastest free-tier Gemini models (lowest latency first):
#   gemini-2.0-flash-lite  — lowest latency, free, recommended for dev/demo
#   gemini-2.0-flash       — slightly more capable, still free
# GEMINI_CHAT_MODEL=gemini-2.0-flash-lite   # default — fastest free-tier model
# GEMINI_CHAT_MODEL=gemini-2.0-flash        # slightly more capable, still free

# ── Ollama (only needed when LLM_PROVIDER=ollama) ────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5-coder:14b

# ── DeepSeek (only needed when LLM_PROVIDER=deepseek) ─────────────────────────
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-flash

# Where ChromaDB stores its data on disk
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Chunking (tune these if retrieval quality is poor)
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# How many code chunks to retrieve per question
TOP_K_RESULTS=5
MAX_CONTEXT_CHARS=14000
QUERY_EXPANSION_ENABLED=true
# fast = one LLM pass per reviewed file (best for whole repos)
# agentic = slower multi-turn tool loop (best for deep single-file analysis)
REVIEW_MODE=fast
REVIEW_MAX_FULL_FILES=8
REVIEW_CONCURRENCY=2

# ── LangSmith Observability (optional but highly recommended) ─────────────────
# Sign up FREE at https://smith.langchain.com — no credit card needed.
# Once set, every LLM call, retrieval result, and token count is logged
# with a shareable URL. You can send a trace link to interviewers.
#
# 1. Go to smith.langchain.com → Settings → API Keys → Create Key
# 2. Set these three vars (on Railway too, under Variables):
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=codesage

# ── Authentication ─────────────────────────────────────────────────────────────
# Protects all API endpoints from unauthorised use.
# If unset, the server runs open (safe for local dev — no config needed).
# In production (Railway), set this to a random secret and pass it from your
# frontend via the X-API-Key request header.
#
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
# API_KEY=your-secret-key-here

# ── Production / Railway ───────────────────────────────────────────────────────
# PORT is injected automatically by Railway — do NOT set it manually on Railway.
# Locally, leave it unset (defaults to 8000).
# PORT=8000

# Comma-separated list of allowed frontend origins.
# Set this on Railway to your Vercel URL, e.g.:
# CORS_ORIGINS=https://codesage.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
