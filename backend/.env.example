# Copy this file to .env and fill in your values
# Never commit .env to git — it's in .gitignore

# ── Provider selection ────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "ollama", "deepseek", or "openai".
#
#   ollama   → FULLY LOCAL. No API key, no account, no network, no quota.
#              THE DEFAULT. Chat runs on a local open-weight model; embeddings
#              and reranking already run locally for every provider.
#              Prerequisite: https://ollama.com, then `ollama pull` the model.
#
#   deepseek → Hosted DeepSeek API, cheap but PAID. Needs DEEPSEEK_API_KEY.
#              Uses the OpenAI-compatible API and falls back to local Ollama.
#
#   openai   → GPT-4o for chat and text-embedding-3-small for embeddings.
#              Needs OPENAI_API_KEY. Best quality, costs ~$0.01/question.
#
# Every feature in this repo works on the ollama path. Nothing here requires a
# credit card; `deepseek` and `openai` are upgrades, not requirements.
# tests/test_provider_config.py enforces that this file only ever names a
# provider the code actually accepts — a doc that names a provider the config
# rejects fails at startup, before any route runs.
#
# ⚠️  IMPORTANT: the embedding model is fixed at index time.
#     Switching providers, or changing EMBEDDING_MODEL below, produces a
#     collection whose vectors are not comparable with the new model's. You MUST
#     wipe chroma_data/ and re-index. Mixing dimensions (384 vs 768) does not
#     error — it returns noise, which is worse.
LLM_PROVIDER=ollama
# LLM_PROVIDER=deepseek
# LLM_PROVIDER=openai

# ── Ollama (used when LLM_PROVIDER=ollama) ───────────────────────────────────
# Model sizes are listed because a default nobody can run is not a default.
# The default below runs on an 8 GB laptop on CPU.
#
#   qwen2.5-coder:7b   ~4.7 GB   Apache-2.0   ← default, fits 8 GB
#   qwen2.5-coder:14b  ~9.0 GB   Apache-2.0     better, wants ~16 GB or a GPU
#   qwen2.5-coder:32b  ~20 GB    Apache-2.0     best local, wants ~32 GB
#
# Quickstart from nothing:
#   ollama serve
#   ollama pull qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b

# Optional: a separate model for code review reasoning (Tier 2).
# Left empty on purpose — an empty value uses OLLAMA_CHAT_MODEL, so a fresh
# install downloads ONE model instead of two before a review can run.
# Set it if you have the RAM and want stronger review reasoning:
#   OLLAMA_REVIEW_MODEL=deepseek-r1:7b    ~4.7 GB, MIT
#   OLLAMA_REVIEW_MODEL=deepseek-r1:14b   ~9.0 GB, MIT
# OLLAMA_REVIEW_MODEL=

# Optional: cheaper/faster model for low-risk files (Tier-1 routing).
# Empty disables Tier-1 routing, so every file uses the full model.
# OLLAMA_FAST_MODEL=qwen2.5-coder:1.5b

# ── DeepSeek (only needed when LLM_PROVIDER=deepseek) ─────────────────────────
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── OpenAI (only needed when LLM_PROVIDER=openai) ────────────────────────────
# OPENAI_API_KEY=sk-...your-key-here...
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DEEPSEEK_CHAT_MODEL=deepseek-flash

# ── Embeddings (the retrieval model — all providers except openai) ────────────
# This model decides WHICH code the LLM is allowed to read, so it sets a ceiling
# on answer quality: a perfect 7B coder handed the wrong three chunks still
# answers wrong. It is the one model here that is not trained on code.
#
#   sentence-transformers/all-MiniLM-L6-v2   384d  ~80 MB  Apache-2.0  ← default
#       General-purpose English sentences. Fast, runs anywhere.
#       ⚠️  It reads only 256 tokens and silently discards the rest. The chunker
#           emits up to 3000 characters, so a large share of chunks are truncated
#           before they are ever embedded. Retrieval still works (BM25 sees the
#           full text) but semantic search degrades with nothing in the logs.
#
#   jinaai/jina-embeddings-v2-base-code      768d  ~640 MB Apache-2.0
#       Trained on github-code + 150M code Q&A pairs. 8K context, 30 languages.
#       Strictly better retrieval on code, and its window swallows the chunker's
#       ceiling whole. Costs one re-index, because 768 ≠ 384.
#       Enable with:  EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Batch size for local embedding. The previous hardcoded value was 1, which
# leaves the hardware idle. This affects indexing *speed*, not the vectors —
# each row is encoded independently and padding is attention-masked.
EMBEDDING_BATCH_SIZE=32

# auto | cpu | cuda | mps. "auto" uses CUDA when torch can see a GPU and falls
# back to CPU otherwise, so one default is correct on a laptop and a workstation.
EMBEDDING_DEVICE=auto

# Where ChromaDB stores its data on disk
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Chunking (tune these if retrieval quality is poor)
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# How many code chunks to retrieve per question
TOP_K_RESULTS=5
MAX_CONTEXT_CHARS=14000
QUERY_EXPANSION_ENABLED=true
# fast = one LLM pass per reviewed file (best for whole repos)
# agentic = slower multi-turn tool loop (best for deep single-file analysis)
REVIEW_MODE=fast
# REVIEW_MAX_FULL_FILES=8   # legacy: caps files reviewed when no planner budget
REVIEW_LLM_BUDGET=12        # single-file model reviews per run; the rest batch
REVIEW_CONCURRENCY=2
REVIEW_CACHE_ENABLED=true   # reuse a file's review when its content is unchanged

# ── Risk policy gate ─────────────────────────────────────────────────────────
# Scores every change 0-10 (higher = riskier) from the findings it *introduces*,
# the paths it touches, its blast radius through the dependency graph, and
# whether it was verified. Above RISK_APPROVAL_THRESHOLD a push needs a token
# bound to that exact change plus a written reason; at or above
# RISK_BLOCK_THRESHOLD SavFlux refuses outright and hands back the gh command.
# A change the verifier proves does not apply is never pushed, at any score.
# Full docs: GET /api/v1/policy
RISK_GATE_ENABLED=true
RISK_APPROVAL_THRESHOLD=6   # 0-10. 6 = high: sensitive files, or a real finding
RISK_BLOCK_THRESHOLD=10     # 0-10. 10 = nothing is unapprovable except the worst

# ── LangSmith Observability (optional but highly recommended) ─────────────────
# Sign up FREE at https://smith.langchain.com — no credit card needed.
# Once set, every LLM call, retrieval result, and token count is logged
# with a shareable URL. You can send a trace link to interviewers.
#
# 1. Go to smith.langchain.com → Settings → API Keys → Create Key
# 2. Set these three vars (on Railway too, under Variables):
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=savflux

# ── Authentication ─────────────────────────────────────────────────────────────
# Protects all API endpoints from unauthorised use.
# If unset, the server runs open (safe for local dev — no config needed).
# In production (Railway), set this to a random secret and pass it from your
# frontend via the X-API-Key request header.
#
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
# API_KEY=your-secret-key-here

# ── Production / Railway ───────────────────────────────────────────────────────
# PORT is injected automatically by Railway — do NOT set it manually on Railway.
# Locally, leave it unset (defaults to 8000).
# PORT=8000

# Comma-separated list of allowed frontend origins.
# Set this on Railway to your Vercel URL, e.g.:
# CORS_ORIGINS=https://savflux.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
